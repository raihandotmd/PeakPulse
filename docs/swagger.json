                    "type": "string"
                },
                "exercise_id": {
                    "type": "string"
                },
                "exercise_name": {
                    "type": "string"
                },
                "plan_description": {
                    "type": "string"
                },
                "plan_id": {
                    "type": "string"
                },
                "plan_title": {
                    "type": "string"
                },
